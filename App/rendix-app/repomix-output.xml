  const handleSubmit = async (e) => {
    e.preventDefault();
    if (!form.vehicleId) {
      alert('Debes seleccionar o tener registrado al menos un vehículo.');
      return;
    }
    setLoading(true);
    await onSubmit(form);
    setLoading(false);
  };

  return (
    <div style={{
