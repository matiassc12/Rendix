/* ==========================================
   VARIABLES DE TEMA (CLARO Y OSCURO)
   ========================================== */
:root[data-theme='dark'] {
  --bg-primary: #0b1120;
  --bg-secondary: #1e293b;
  --bg-card: #1e293b;
  --bg-card-inner: #0f172a;
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --border-color: #334155;
  --sidebar-bg: #0f172a;
}

:root[data-theme='light'] {
  --bg-primary: #f8fafc;
  --bg-secondary: #ffffff;
  --bg-card: #ffffff;
  --bg-card-inner: #f1f5f9;
  --text-primary: #0f172a;
  --text-secondary: #64748b;
  --border-color: #cbd5e1;
  --sidebar-bg: #ffffff;
}

/* ==========================================
   RESET GLOBAL DE PANTALLA
   ========================================== */
html, body, #root {
  margin: 0;
  padding: 0;
  width: 100%;
  min-height: 100vh;
  background-color: var(--bg-primary) !important;
  color: var(--text-primary);
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  overflow-x: hidden;
  box-sizing: border-box;
}

*, *:before, *:after {
  box-sizing: inherit;
}

/* ==========================================
   LAYOUT PRINCIPAL DE ESCRITORIO
   ========================================== */
.app-container {
  display: flex;
  width: 100vw;
  min-height: 100vh;
  background-color: var(--bg-primary);
  position: relative;
  overflow-x: hidden;
}

.main-content {
  margin-left: 260px; /* Ancho exacto del sidebar fijo */
  width: calc(100vw - 260px);
  min-height: 100vh;
  padding: 30px;
  box-sizing: border-box;
  background-color: var(--bg-primary);
}

.mobile-topbar {
  display: none;
}

.sidebar-overlay {
  display: none;
}

/* ==========================================
   SCROLLBARS LIMPIOS
   ========================================== */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: var(--bg-primary);
}
::-webkit-scrollbar-thumb {
  background: var(--border-color);
  border-radius: 3px;
}

/* ==========================================
   ADAPTACIÓN MÓVIL (<= 768px)
   ========================================== */
@media (max-width: 768px) {
  .mobile-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--sidebar-bg);
    border-bottom: 1px solid var(--border-color);
    padding: 12px 16px;
    position: sticky;
    top: 0;
    z-index: 90;
    width: 100%;
  }

  .main-content {
    margin-left: 0 !important;
    width: 100vw !important;
    padding: 16px !important;
  }

  .sidebar-container {
    transform: translateX(-100%);
    transition: transform 0.3s ease-in-out;
    position: fixed !important;
    top: 0;
    left: 0;
    z-index: 100;
  }

  .sidebar-container.open {
    transform: translateX(0);
    box-shadow: 20px 0 50px rgba(0, 0, 0, 0.5);
  }

  .sidebar-overlay.open {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    z-index: 99;
  }
}
