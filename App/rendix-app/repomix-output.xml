      </tr>
    `;
  }).join('');

  if (vehicles.length === 0) {
    vehiclesRowsHtml = `<tr><td colspan="5" style="padding: 20px; text-align: center; color: #64748b;">No hay vehículos registrados en la flota.</td></tr>`;
