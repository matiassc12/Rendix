                <input
                  type="number"
                  value={fuelPrice}
                  onChange={(e) => setFuelPrice(e.target.value)}
                  style={inputStyle}
                />
              </div>
              <div>
                <label style={labelStyle}>Peajes / TAG ($)</label>
                <input
                  type="number"
                  value={tolls}
                  onChange={(e) => setTolls(e.target.value)}
                  style={inputStyle}
                />
              </div>
            </div>

            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '12px' }}>
              <div>
                <label style={labelStyle}>Reserva Desgaste ($/km)</label>
                <input
                  type="number"
                  value={wearPerKm}
                  onChange={(e) => setWearPerKm(e.target.value)}
                  style={inputStyle}
                />
              </div>
              <div>
                <label style={labelStyle}>Margen Ganancia (%)</label>
                <input
                  type="number"
                  value={marginPercent}
                  onChange={(e) => setMarginPercent(e.target.value)}
                  style={inputStyle}
                />
              </div>
            </div>
          </div>

          {/* TARJETAS FINANCIERAS */}
          <div style={{ background: '#0f172a', padding: '16px', borderRadius: '12px', border: '1px solid #334155', display: 'flex', flexDirection: 'column', gap: '10px' }}>
            
            <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: '13px' }}>
              <span style={{ color: '#94a3b8' }}>Combustible Requerido:</span>
              <strong style={{ color: '#f8fafc' }}>{litersNeeded.toFixed(2)} Litros</strong>
            </div>

            <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: '13px' }}>
              <span style={{ color: '#94a3b8' }}>Gasto Combustible + Peajes:</span>
              <strong style={{ color: '#fca5a5' }}>${Math.round(fuelCostTotal + tollsNum).toLocaleString('es-CL')}</strong>
            </div>

            <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: '13px' }}>
              <span style={{ color: '#94a3b8' }}>Reserva Mantención / Neumáticos:</span>
              <strong style={{ color: '#eab308' }}>${Math.round(wearCostTotal).toLocaleString('es-CL')}</strong>
            </div>

            <hr style={{ borderColor: '#334155', margin: '4px 0' }} />

            <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: '14px' }}>
              <span style={{ color: '#cbd5e1', fontWeight: '700' }}>COSTO OPERATIVO REAL:</span>
              <strong style={{ color: '#38bdf8', fontSize: '18px', fontWeight: '900' }}>
                ${Math.round(directOperatingCost).toLocaleString('es-CL')}
              </strong>
            </div>

            <div style={{ background: 'rgba(34, 197, 94, 0.15)', border: '1px solid rgba(34, 197, 94, 0.4)', padding: '14px', borderRadius: '10px', display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginTop: '6px' }}>
              <div>
                <div style={{ fontSize: '11px', color: '#4ade80', fontWeight: '900', textTransform: 'uppercase', letterSpacing: '0.5px' }}>TARIFA SUGERIDA DE FLETE</div>
                <div style={{ fontSize: '12px', color: '#cbd5e1', marginTop: '2px' }}>Ganancia Neta: +${Math.round(netProfit).toLocaleString('es-CL')}</div>
              </div>
              <div style={{ fontSize: '22px', fontWeight: '950', color: '#22c55e' }}>
                ${Math.round(suggestedFreightTariff).toLocaleString('es-CL')}
              </div>
            </div>

          </div>

        </div>
      </div>

    </div>
  );
}

const labelStyle = { display: 'block', fontSize: '11px', fontWeight: '700', color: '#cbd5e1', marginBottom: '4px' };
const inputStyle = { width: '100%', padding: '9px 12px', borderRadius: '8px', border: '1px solid #334155', background: '#0f172a', color: '#f8fafc', fontSize: '13px', outline: 'none', boxSizing: 'border-box' };
</file>

